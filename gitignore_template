# ============================================================
#  .gitignore  —  F1TENTH ROS 2 workspace
#  Place at the repo root. Keeps machine-specific build
#  artifacts and caches out of git; commits only source.
# ============================================================

# --- ROS 2 / colcon build output (regenerated by `colcon build`) ---
build/
install/
log/

# --- backend's own colcon leftovers, if the gym was ever colcon-built ---
**/f1tenth_gym/build/
**/f1tenth_gym/install/
**/f1tenth_gym/log/

# --- Python / numba caches ---
__pycache__/
*.py[cod]
*.nbc
*.egg-info/
*.egg-link
.eggs/

# --- virtual environments (never commit these) ---
gym_env/
venv/
.venv/
env/

# --- editor / OS cruft ---
.vscode/
.idea/
*.swp
*~
.DS_Store

# --- optional: logged run output you may not want in git ---
# (uncomment if your logger/profiler write here)
# **/output_logs/
# **/waypoints_*.csv
