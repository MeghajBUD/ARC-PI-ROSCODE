{
  "name": "RoboRacer ROS Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "WORKSPACE": "roboracer-purdue"
    }
  },
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "twxs.cmake",
        "ms-vscode.cpptools"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "VNC Web Client",
      "onAutoForward": "openPreview"
    }
  },
  "runArgs": ["--network=host"],
  "workspaceMount": "",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}