{
  "name": "RoboRacer ROS Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "WORKSPACE": "roboracer-purdue"
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "twxs.cmake",
        "ms-vscode.cpptools"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash /usr/local/bin/start-vnc.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "VNC Web Client",
      "onAutoForward": "openPreview"
    }
  },
  "runArgs": ["--network=host"],
  "workspaceMount": "",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}